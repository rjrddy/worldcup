# ─── Data provider selection ───────────────────────────────
# "mock"          → seed data (Brazil vs Morocco demo, no network)
# "api-football"  → reads cached JSON from ./data/ (run `npm run fetch:data` first)
# "fotmob"        → undocumented FotMob endpoints (skeleton stubs)
DATA_PROVIDER=api-football

# ─── api-football credentials ──────────────────────────────
# REQUIRED only for `npm run fetch:data`. The deployed app reads pre-fetched
# JSON from ./data/ — Vercel does NOT need this key at runtime.
# Sign up: https://www.api-football.com  (Pro tier needed for 2026 season)
API_FOOTBALL_KEY=

# Override only if api-football changes their internal IDs.
API_FOOTBALL_WC_LEAGUE_ID=1
API_FOOTBALL_WC_SEASON=2026
API_FOOTBALL_CLUB_SEASON=2025

# Cap lineup fetches per `npm run fetch:data` run.
MAX_LINEUP_FETCHES=20

# Inter-call pacing in milliseconds. 200ms = 5 req/sec, well under Pro's 450/min.
API_FOOTBALL_PACE_MS=200

# ─── Transfermarkt scraper (npm run scrape:values) ─────────
# Higher delay = fewer Cloudflare blocks.
SCRAPE_DELAY_MS=3000

# ─── FotMob (unused unless DATA_PROVIDER=fotmob) ───────────
FOTMOB_X_MAS_HEADER=
